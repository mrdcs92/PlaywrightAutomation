{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "End-to-end test automation framework using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:clientBooking": "playwright test --grep @clientBooking",
    "test:clientOrder": "playwright test --grep @clientOrder",
    "test:errorValidation": "playwright test --grep @errorValidation",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0"
  }
}